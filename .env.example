# Base URL of the backend API. This is the only required build-time
# variable - Vite bakes VITE_* vars into the static bundle at build
# time, so the app must be rebuilt (not just redeployed) whenever this
# changes. In production, point this at the real API origin over HTTPS,
# e.g. https://api.yourdomain.com/api - never a localhost value.
VITE_API_BASE_URL=http://localhost:8000/api
